---
import { getEntry, render } from "astro:content";
import SelfHostingPage from "../../components/SelfHostingPage.astro";

const doc = await getEntry("docs", "self-hosting-docker/ja");
if (!doc) {
  throw new Error("Missing Japanese self-hosting-docker docs entry.");
}

const { Content } = await render(doc);
---

<SelfHostingPage Content={Content} doc={doc} locale="ja" />
